{
  "name": "ravelry-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Ravelry knitting/crochet API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ravelry-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "ravelry",
    "knitting",
    "crochet",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buzzsurfr/ravelry-mcp"
  }
}
